<!--
  The "cargo wix" subcommand provides a variety of predefined variables available
  for customization of this template. The values for each variable are set at
  installer creation time. The following variables are available:

  TargetTriple      = The rustc target triple name.
  TargetEnv         = The rustc target environment. This is typically either
                      "msvc" or "gnu" depending on the toolchain downloaded and
                      installed.
  TargetVendor      = The rustc target vendor. This is typically "pc", but Rust
                      does support other vendors, like "uwp".
  CargoTargetBinDir = The complete path to the directory containing the
                      binaries (exes) to include. The default would be
                      "target\release\". If an explicit rustc target triple is
                      used, i.e. cross-compiling, then the default path would
                      be "target\<CARGO_TARGET>\<CARGO_PROFILE>",
                      where "<CARGO_TARGET>" is replaced with the "CargoTarget"
                      variable value and "<CARGO_PROFILE>" is replaced with the
                      value from the "CargoProfile" variable. This can also
                      be overridden manually with the "target-bin-dir" flag.
  CargoTargetDir    = The path to the directory for the build artifacts, i.e.
                      "target".
  CargoProfile      = The cargo profile used to build the binaries
                      (usually "debug" or "release").
  Version           = The version for the installer. The default is the
                      "Major.Minor.Fix" semantic versioning number of the Rust
                      package.
-->

<!--
  Please do not remove these pre-processor If-Else blocks. These are used with
  the `cargo wix` subcommand to automatically determine the installation
  destination for 32-bit versus 64-bit installers. Removal of these lines will
  cause installation errors.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Kuvatin'
        UpgradeCode='6CE48F37-33A2-4C50-99F4-F6982CCA934C'
        Manufacturer='Ville Mattila'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Kuvatin image tool with Windows Explorer context-menu integration'
            Manufacturer='Ville Mattila'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <!--
          AllowSameVersionUpgrades makes the installer remove any existing
          install (same OR lower version) before installing, so it always
          replaces the old app rather than placing a second copy alongside it.
        -->
        <MajorUpgrade
            AllowSameVersionUpgrades='yes'
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Kuvatin Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='kuvatin'>
                    <!--
                      Disabling the license sidecar file in the installer is a two step process:

                      1. Comment out or remove the `Component` tag along with its contents.
                      2. Comment out or remove the `ComponentRef` tag with the "License" Id
                         attribute value further down in this file.
                    -->
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='wix\License.rtf'
                            KeyPath='yes'/>
                    </Component>
                    
                    <Directory Id='Bin' Name='bin'>
                        <!-- NOTE: the installer deliberately does NOT touch the
                             system PATH. The exe's DLLs (GStreamer runtime) sit
                             beside it in [Bin] and nothing else needs to resolve
                             kuvatin.exe from a shell, so a PATH entry would only
                             shadow a user's own GStreamer install with our
                             bundled copies. -->
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='kuvatin.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\kuvatin.exe'
                                KeyPath='yes'/>
                        </Component>
                        <!-- Windows 11 top-level context menu: the IExplorerCommand
                             handler DLL and the sparse package that gives this
                             folder package identity (see crates\kuvatin\msix).
                             the register step registers the package per user, next to
                             the classic registry menu; Windows 10 skips it. -->
                        <Component Id='shellext' Guid='*'>
                            <File
                                Id='shellext_dll'
                                Name='kuvatin_shellext.dll'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\kuvatin_shellext.dll'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='msix' Guid='*'>
                            <File
                                Id='msix_file'
                                Name='Kuvatin.msix'
                                DiskId='1'
                                Source='$(var.MsixPath)'
                                KeyPath='yes'/>
                        </Component>
<?ifdef SignCerPath?>
                        <!-- The certificate Kuvatin.msix is signed with: the
                             installer trusts it machine-wide (Trusted People),
                             which is what lets the register step register the package. -->
                        <Component Id='signcer' Guid='*'>
                            <File
                                Id='signcer_file'
                                Name='kuvatin-signing.cer'
                                DiskId='1'
                                Source='$(var.SignCerPath)'
                                KeyPath='yes'/>
                        </Component>
<?endif?>
                    </Directory>
                </Directory>
            </Directory>

            <!-- Start menu shortcut. The package is per-machine (so this lands in
                 the all-users Start menu), but WiX's validators treat any
                 ProgramMenuFolder shortcut as user-profile data: ICE38/ICE43
                 REQUIRE a non-advertised shortcut component's keypath to be an
                 HKCU value, and an HKLM or HKMU keypath fails ICE57. So the
                 keypath is HKCU by rule, not by choice (verified: the HKLM
                 variant the review suggested fails the build). -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Kuvatin'>
                    <Component Id='StartMenuShortcut' Guid='*'>
                        <Shortcut Id='AppStartMenuShortcut'
                                  Name='Kuvatin'
                                  Description='Batch image converter / resizer / cropper and video editor'
                                  Target='[Bin]kuvatin.exe'
                                  WorkingDirectory='Bin'
                                  Icon='ProductICO'/>
                        <RemoveFolder Id='RemoveApplicationProgramsFolder'
                                      On='uninstall'/>
                        <RegistryValue Root='HKCU'
                                       Key='Software\Ville Mattila\Kuvatin'
                                       Name='installed'
                                       Type='integer'
                                       Value='1'
                                       KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <!--
              Comment out or remove the following `ComponentRef` tag to remove
              the license sidecar file from the installer.
            -->
            <ComponentRef Id='License'/>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='shellext'/>
            <ComponentRef Id='msix'/>
<?ifdef SignCerPath?>
            <ComponentRef Id='signcer'/>
<?endif?>
            <ComponentRef Id='StartMenuShortcut'/>

            <!-- Bundled GStreamer runtime (DLLs next to the exe + plugins subdir),
                 harvested by wix/bundle-gstreamer.ps1 into wix/gstreamer.wxs.
                 NOTE: gstreamer.wxs is regenerated each build with `heat -gg`
                 (fresh component GUIDs). That is ONLY safe because MajorUpgrade
                 below uses Schedule='afterInstallInitialize', which removes the
                 old product completely before installing the new one. Change
                 either of the two only together, or upgrades will orphan files. -->
            <ComponentGroupRef Id='GstRuntime'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <!-- Apps & Features entry links (WixUI_InstallDir already sets ARPNOMODIFY). -->
        <Property Id='ARPURLINFOABOUT' Value='https://ville-mattila.github.io/Kuvatin/'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/Ville-Mattila/Kuvatin/issues'/>
        <Property Id='ARPURLUPDATEINFO' Value='https://github.com/Ville-Mattila/Kuvatin/releases'/>

        <!--
          Register / unregister the Windows Explorer context-menu entries by
          invoking the installed kuvatin.exe with the register / unregister
          flags. These run as deferred custom actions sequenced around
          InstallFiles / RemoveFiles so the exe exists when registering and is
          still present when unregistering. Return='ignore' keeps a
          registration hiccup from aborting the install/uninstall, and
          the quiet flag keeps the exe from popping an error dialog inside the
          install (a deferred action's message box would block it); the
          failure is still visible as the exe's exit code in the MSI log.
        -->
        <CustomAction Id='KuvatinRegister'
                      FileKey='exe0'
                      ExeCommand='--register --quiet'
                      Execute='deferred'
                      Impersonate='yes'
                      Return='ignore' />
        <CustomAction Id='KuvatinUnregister'
                      FileKey='exe0'
                      ExeCommand='--unregister --quiet'
                      Execute='deferred'
                      Impersonate='yes'
                      Return='ignore' />

<?ifdef SignCerPath?>
        <!--
          The Windows 11 menu package is signed; its certificate must be in the
          machine's Trusted People store before the register step can register it (a
          self-signed certificate is trusted only by this store, a CA-issued one
          needs nothing but is not hurt). System context, no impersonation: the
          store is per machine. Removed again on uninstall, by thumbprint.
        -->
        <CustomAction Id='KuvatinTrustCert'
                      Directory='Bin'
                      ExeCommand='"[System64Folder]certutil.exe" -f -addstore TrustedPeople "[Bin]kuvatin-signing.cer"'
                      Execute='deferred'
                      Impersonate='no'
                      Return='ignore' />
        <CustomAction Id='KuvatinUntrustCert'
                      Directory='Bin'
                      ExeCommand='"[System64Folder]certutil.exe" -delstore TrustedPeople $(var.SignCerThumbprint)'
                      Execute='deferred'
                      Impersonate='no'
                      Return='ignore' />
<?endif?>

        <InstallExecuteSequence>
<?ifdef SignCerPath?>
            <Custom Action='KuvatinTrustCert' After='InstallFiles'>NOT Installed</Custom>
            <Custom Action='KuvatinRegister' After='KuvatinTrustCert'>NOT Installed</Custom>
            <Custom Action='KuvatinUnregister' Before='RemoveFiles'>Installed AND (REMOVE="ALL")</Custom>
            <Custom Action='KuvatinUntrustCert' After='KuvatinUnregister'>Installed AND (REMOVE="ALL")</Custom>
<?else?>
            <Custom Action='KuvatinRegister' After='InstallFiles'>NOT Installed</Custom>
            <Custom Action='KuvatinUnregister' Before='RemoveFiles'>Installed AND (REMOVE="ALL")</Custom>
<?endif?>
        </InstallExecuteSequence>

        
        <!--
          Uncomment the following `Icon` and `Property` tags to change the product icon.

          The product icon is the graphic that appears in the Add/Remove
          Programs control panel for the application.
        -->
        <Icon Id='ProductICO' SourceFile='assets\kuvatin.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />

        
        <!--
          Adding a URL to Add/Remove Programs control panel listing for the
          application is a two step process:

          1. Uncomment the following `Property` tag with the "ARPHELPLINK" Id
             attribute value.
          2. Change the value for `Value` attribute of the following
             `Property` tag to a valid URL.
        -->
        <!-- One mandatory feature: a feature tree would show a single box that
             can't be unticked, so the UI asks only for the install folder. -->
        <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>
        <UI>
            <UIRef Id='WixUI_InstallDir'/>
        </UI>

        <!--
          Disabling the EULA dialog in the installer requires commenting out
          or removing the following `WixVariable` tag
        -->
        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>
        
        
        <!--
          Uncomment the next `WixVariable` tag to customize the installer's
          Graphical User Interface (GUI) and add a custom banner image across
          the top of each screen. See the WiX Toolset documentation for details
          about customization.

          The banner BMP dimensions are 493 x 58 pixels.
        -->
        <!--<WixVariable Id='WixUIBannerBmp' Value='wix\Banner.bmp'/>-->

        
        <!--
          Uncomment the next `WixVariable` tag to customize the installer's
          Graphical User Interface (GUI) and add a custom image to the first
          dialog, or screen. See the WiX Toolset documentation for details about
          customization.

          The dialog BMP dimensions are 493 x 312 pixels.
        -->
        <!--<WixVariable Id='WixUIDialogBmp' Value='wix\Dialog.bmp'/>-->

    </Product>

</Wix>
