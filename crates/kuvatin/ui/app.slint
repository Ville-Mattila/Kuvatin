import { ComboBox, ListView, LineEdit, SpinBox, CheckBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Modal } from "modal.slint";
import {
    QualitySlider, Card, SecondaryButton, DialogButton, RemoveButton, FieldLabel, CropHandle,
    WinButton, SegToggle, Splitter, NumberDropdown, PillButton, Scrubber, InspSlider
} from "widgets.slint";
export { ProgressWindow } from "progress.slint";

export struct FileRow {
    name: string,
    status: string,
    thumb: image,
    dims: string,
    cropped: bool,
    result: string,    // after a run: "410 KB (-66%)", else empty
}

// What a timeline clip is (drives its colour and whether it has audio).
export enum ClipKind { video, image, sequence }

// A clip placed on the video timeline. Positions are in seconds; the UI maps
// them to pixels via the pixels-per-second zoom.
export struct TimelineClip {
    id: string,        // GES clip name (identifies the clip for edits)
    track: int,        // 0 = top row = GES layer 0 (composited on top)
    start: float,      // seconds from the timeline origin
    duration: float,   // seconds
    inpoint: float,    // seconds into the source (trim offset)
    name: string,
    kind: ClipKind,
    selected: bool,
    thumb: image,
}

// A media-bin entry: file name + a generated thumbnail.
export struct VideoAsset {
    name: string,
    thumb: image,
}

// What a pointer drag on a timeline clip is doing.
enum DragMode { idle, slide, trim-left, trim-right }
// What a pointer drag on the preview's selection box is doing.
enum EditMode { none, move, resize }

export component AppWindow inherits Window {
    title: "Kuvatin";
    icon: @image-url("../assets/kuvatin-icon.png");
    no-frame: true;
    preferred-width: 1320px;
    preferred-height: 840px;
    min-width: 860px;
    min-height: 560px;
    background: Theme.window;

    in property <[FileRow]> files;
    in property <[string]> preset-names;
    in property <bool> running: false;
    in property <float> progress: 0.0;
    in-out property <int> current-preset: 0;
    in-out property <string> format: "webp";
    in-out property <int> quality: 80;
    // PNG optimization mode: 0 = Normal, 1 = Optimize (lossless), 2 = Compress (lossy).
    in-out property <int> png-mode: 0;
    in-out property <string> preset-name;
    in-out property <bool> confirm-delete: false;   // "Delete this preset?" dialog open
    // 0 = Images, 1 = Videos (the SegToggle index; both modes are live).
    in-out property <int> app-mode: 0;
    // Adjustable side-panel widths (drag the splitters between cards). The viewer
    // takes the remaining space.
    in-out property <length> files-w: 280px;
    in-out property <length> settings-w: 340px;
    // Video mode: adjustable media-bin and inspector widths (draggable splitters).
    in-out property <length> video-bin-w: 186px;
    in-out property <length> video-insp-w: 238px;

    // Video mode state (set from Rust) and actions.
    in property <image> video-frame;
    in-out property <bool> video-playing: false;
    in property <float> video-position: 0.0;        // 0..1 along the clip
    in property <string> video-time: "0:00 / 0:00";
    in-out property <float> video-volume: 1.0;       // 0..1
    in property <[VideoAsset]> video-clips;
    callback video-open();
    callback video-add(int);               // add a media-bin item to the timeline
    // Image-sequence import: pick the first frame, then confirm fps in a dialog.
    callback video-open-sequence();
    callback seq-confirm();                    // add the detected sequence
    in-out property <bool> seq-config: false;  // sequence confirm dialog open
    in property <string> seq-range: "";        // "frame_0001.png → frame_0172.png"
    in property <int> seq-count: 0;            // detected frame count
    in-out property <int> seq-fps: 30;         // one file = one frame at this rate
    callback video-playpause();
    callback video-seek(float);            // fraction 0..1
    callback seek-done();                  // scrub released → land frame-accurately
    callback video-volume-changed(float);  // 0..1
    in-out property <bool> video-repeat: false;  // loop playback at the end
    // The GStreamer engine failed to initialise (set from Rust): the media
    // actions are disabled rather than silently doing nothing.
    in-out property <bool> video-engine-down: false;

    // Timeline editor.
    in property <[TimelineClip]> timeline-clips;
    in property <[string]> timeline-track-labels;  // one per track, top row first
    // Height of a single timeline track row. One source of truth: the band
    // height, header rows, lane stripes, clip Y and every drag/reorder distance
    // are all derived from this (change it here and the whole timeline follows).
    property <length> track-h: Theme.track-h;
    in property <float> timeline-pps: 14.0;   // pixels per second (zoom)
    in-out property <length> tl-scroll: 0px;  // horizontal scroll offset of the lane
    in property <float> playhead: 0.0;        // seconds
    in property <float> timeline-duration: 0.0; // seconds (for the ruler end)
    in property <string> inspector-name: "";  // selected clip name (or empty)
    // Selected clip transform for the inspector (set from Rust on select).
    in-out property <float> insp-posx: 0;      // px within the canvas
    in-out property <float> insp-posy: 0;      // px
    in-out property <float> insp-scale: 100;   // percent of the canvas size
    in-out property <float> insp-alpha: 100;   // opacity percent
    in-out property <float> insp-volume: 100;  // percent
    in property <bool> insp-has-audio: true;   // hide volume for stills
    // Selected clip's aspect-fit size in canvas px (for the preview bounding box).
    in property <float> sel-fit-w: 1280;
    in property <float> sel-fit-h: 720;
    // Composited canvas ("viewport") size — editable. Drives the preview mapping,
    // the inspector position ranges, and the default export size. Edits go back to
    // Rust via set-canvas-size.
    in-out property <int> canvas-w: 1280;
    in-out property <int> canvas-h: 720;
    callback set-canvas-size(int, int);   // new viewport dimensions (px)
    // Export configuration modal + settings.
    in-out property <bool> export-config: false;   // settings dialog open
    in-out property <int> export-codec: 0;          // 0=H.264/MP4, 1=VP9/WebM, 2=VP8/WebM
    in-out property <int> export-w: 1280;
    in-out property <int> export-h: 720;
    in-out property <int> export-fps: 30;            // output frames per second
    in-out property <int> export-bitrate: 8000;     // target video bitrate, kbps
    // Timeline drag state (drives the "new track" drop indicator).
    in-out property <bool> clip-dragging: false;
    in-out property <int> clip-drag-target-row: 0;
    // File import progress (a worker discovers files off the UI thread).
    in property <bool> importing: false;
    in property <int> import-done: 0;
    in property <int> import-total: 0;
    // Export/render progress.
    in property <bool> exporting: false;
    in property <float> export-progress: 0.0;   // 0..1
    in property <string> export-status: "";
    callback video-export();
    callback export-cancel();                  // abort a running render
    callback import-cancel();                  // abort an in-flight media import
    callback add-track();                      // click "+ New track" → new empty row
    // App-wide error surface (a modal that stays until dismissed). Set from Rust
    // via the error-* properties; the OK button clears `error-visible`.
    in-out property <bool> error-visible: false;
    in property <string> error-title: "Something went wrong";
    in property <string> error-detail: "";
    // The same dialog in its neutral form (a batch summary): no red, a check.
    in-out property <bool> dialog-info: false;
    callback video-mode-changed(int);          // 0 = Images, 1 = Videos
    callback inspector-changed();              // any inspector slider moved
    callback inspector-duration-changed(int);  // Duration field (stills), whole seconds
    in-out property <int> insp-duration-s: 5;  // selected clip's length, whole seconds
    in property <bool> insp-is-still: false;   // selected clip is a still image (duration is free)
    callback timeline-select(int);            // clip index
    callback timeline-seek-time(float);       // seconds (from ruler/lane click)
    callback timeline-clip-dropped(int, float, int); // clip index, delta seconds (slide), delta rows (track change)
    callback timeline-clip-trimmed(int, int, float); // clip index, edge (-1 left / +1 right), delta seconds
    callback timeline-clip-removed(int);             // delete the clip at this index
    callback video-bin-removed(int);                 // remove a media-bin entry
    callback track-reordered(int, int);              // drag a track header: from row → to row
    // Magnetic snapping: given the dragged clip and its proposed slide (seconds),
    // returns the slide adjusted so the nearest leading/trailing edge sticks to a
    // neighbouring clip edge or the timeline start (within a pixel threshold).
    // Pure so it can drive the live drag binding. Returns the raw slide if nothing
    // is within range.
    pure callback timeline-snap-dx(int, float, float) -> float; // (idx, slide secs, pps) -> snapped slide secs

    // Crop editor state. The crop rectangle is stored in NORMALIZED coordinates
    // (0..1) relative to the displayed image, so the preview size is irrelevant —
    // Rust maps normalized → absolute pixels using the original image dimensions.
    in-out property <bool> cropping: false;
    in-out property <float> crop-x: 0;
    in-out property <float> crop-y: 0;
    in-out property <float> crop-w: 1;
    in-out property <float> crop-h: 1;
    in-out property <bool> aspect-lock: false;
    // Original (full-resolution) dimensions of the image being cropped, so the
    // numeric X/Y/W/H fields can be shown and edited in absolute pixels.
    in property <int> crop-img-w;
    in property <int> crop-img-h;

    // Output-resolution override (Settings panel). 0 means "use preset size".
    in-out property <int> res-w: 0;
    in-out property <int> res-h: 0;
    in-out property <bool> res-lock: true;

    // Default suffix appended to output file names (e.g. "photo-kuvatin.webp").
    // Seeds the Save dialog name for one file and is applied to every file when
    // converting a batch into a chosen folder. Saved with the preset.
    in-out property <string> suffix: "-kuvatin";
    // When set, outputs go into a subfolder named after the suffix.
    in-out property <bool> save-subfolder: false;

    // Custom window-frame controls (frameless window; wired to Win32 in gui.rs).
    callback win-minimize();
    callback win-maximize();
    callback win-close();

    callback add-files();
    callback clear-files();
    callback remove-file(int);             // the × on a file row
    callback preset-changed(int);
    callback convert();
    callback convert-cancel();             // stop a running batch after the current file
    callback save-preset(string);
    callback rename-preset(string);          // give the selected preset the typed name
    callback move-preset(int);               // -1 = up, +1 = down (menu order follows)
    callback delete-preset();
    // Opt-in update check (Settings > Updates). Off by default: Kuvatin makes
    // no network request unless the user turns it on.
    in-out property <bool> update-check-enabled: false;
    in property <string> update-status: "";
    in property <string> update-available: "";  // newer version, "" when none/unknown
    callback update-check-toggled(bool);
    callback check-updates-now();
    callback open-releases();
    callback apply-crop();

    // Central image viewer.
    in-out property <int> selected-index: -1;
    in property <image> viewer-image;
    callback select-file(int);

    // Keyboard shortcuts (see `kbd` below). Videos: Space toggles play/pause,
    // Delete removes the selected clip. Images: Up/Down/Home/End walk the file
    // list, Delete removes the selected file, Ctrl+O adds files, Ctrl+S saves
    // the preset, Ctrl+Enter converts. Esc dismisses the topmost modal.
    callback delete-selected-clip();
    forward-focus: kbd;

    // A modal's buttons take focus when clicked and are destroyed with the
    // modal; Slint then delivers keys to nothing at all. Hand focus back to
    // the global scope whenever a modal closes, by any path (button, Esc, the
    // Rust side finishing an export or import).
    changed error-visible => { if (!self.error-visible) { kbd.focus(); } }
    changed export-config => { if (!self.export-config) { kbd.focus(); } }
    changed seq-config => { if (!self.seq-config) { kbd.focus(); } }
    changed importing => { if (!self.importing) { kbd.focus(); } }
    changed exporting => { if (!self.exporting) { kbd.focus(); } }
    changed confirm-delete => { if (!self.confirm-delete) { kbd.focus(); } }

    // Global key handling. The FocusScope wraps every child of the window
    // (main layout, drop banner, modals), so a key the focused element rejects
    // bubbles up to it whatever holds focus: a clicked button, a modal button,
    // a file row. A LineEdit that accepts the key (typing digits) still wins.
    // It also takes focus itself when a click lands on nothing focusable.
    // Each group is its own function: the Slint compiler lowers a long chain of
    // `if … return` into nested expressions and overflowed its stack at ~17.
    function modal-keys(event: KeyEvent) -> EventResult {
        // Esc dismisses the topmost modal — every one of them.
        if (event.text != Key.Escape) { return EventResult.reject; }
        if (root.error-visible) { root.error-visible = false; return EventResult.accept; }
        if (root.export-config) { root.export-config = false; return EventResult.accept; }
        if (root.seq-config) { root.seq-config = false; return EventResult.accept; }
        if (root.importing) { root.import-cancel(); return EventResult.accept; }
        if (root.confirm-delete) { root.confirm-delete = false; return EventResult.accept; }
        // No modal is up: Esc stops a running image batch, the way it aborts an
        // import. Harmless in Video mode, where `running` is never set.
        if (root.running) { root.convert-cancel(); return EventResult.accept; }
        return EventResult.reject;
    }
    function video-keys(event: KeyEvent) -> EventResult {
        // Transport/edit keys are dead during an export (the engine ignores
        // them too — this just keeps the play icon from flipping).
        if (root.exporting) { return EventResult.reject; }
        if (event.text == " ") { root.video-playpause(); return EventResult.accept; }
        if (event.text == Key.Delete || event.text == Key.Backspace) { root.delete-selected-clip(); return EventResult.accept; }
        return EventResult.reject;
    }
    function image-keys(event: KeyEvent) -> EventResult {
        // Walk the file list, remove the selected file, and the usual
        // accelerators. A focused LineEdit consumes arrows/Backspace itself,
        // so typing in the numeric fields is never hijacked.
        if (root.running) { return EventResult.reject; }
        if (event.modifiers.control) {
            if (event.text == "o" || event.text == "O") { root.add-files(); return EventResult.accept; }
            if (event.text == "s" || event.text == "S") { root.save-preset(root.preset-name); return EventResult.accept; }
            if (event.text == Key.Return) { root.convert(); return EventResult.accept; }
            return EventResult.reject;
        }
        if (root.files.length == 0) { return EventResult.reject; }
        if (event.text == Key.DownArrow) { root.select-file(Math.min(root.selected-index + 1, root.files.length - 1)); return EventResult.accept; }
        if (event.text == Key.UpArrow) { root.select-file(Math.max(root.selected-index - 1, 0)); return EventResult.accept; }
        if (event.text == Key.Home) { root.select-file(0); return EventResult.accept; }
        if (event.text == Key.End) { root.select-file(root.files.length - 1); return EventResult.accept; }
        if ((event.text == Key.Delete || event.text == Key.Backspace) && root.selected-index >= 0) { root.remove-file(root.selected-index); return EventResult.accept; }
        return EventResult.reject;
    }
    kbd := FocusScope {
        key-pressed(event) => {
            if (root.modal-keys(event) == EventResult.accept) { return accept; }
            if (root.app-mode == 1) { return root.video-keys(event); }
            return root.image-keys(event);
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Custom title bar ----------------------------------------------
            Rectangle {
                min-height: 36px;
                max-height: 36px;
                background: Theme.window;

                // Dragging is handled natively via WM_NCHITTEST (HTCAPTION) in the
                // Win32 subclass; the window buttons stay clickable (HTCLIENT).
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 8px;

                    Image {
                        source: @image-url("../assets/kuvatin-icon.svg");
                        width: 20px;
                        height: 20px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Kuvatin";
                        color: Theme.ink;
                        font-size: 14px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    WinButton { kind: "min"; clicked => { root.win-minimize(); } }
                    WinButton { kind: "max"; clicked => { root.win-maximize(); } }
                    WinButton { kind: "close"; danger: true; clicked => { root.win-close(); } }
                }
            }

            // Mode toggle bar — below the titlebar (client area) so clicks register.
            // In the titlebar, the native drag hit-test (HTCAPTION) swallows clicks.
            Rectangle {
                height: 42px;
                background: Theme.window;
                SegToggle {
                    width: 184px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    labels: ["Images", "Videos"];
                    selected: root.app-mode;
                    select(i) => { root.app-mode = i; root.video-mode-changed(i); }
                }
                // A newer release exists (only ever set by the opt-in check).
                if root.update-available != "" : Rectangle {
                    x: parent.width - self.width - 14px;
                    y: (parent.height - self.height) / 2;
                    width: badge-t.preferred-width + 22px;
                    height: 24px;
                    border-radius: 12px;
                    background: badge-ta.has-hover ? Theme.accent-pressed : Theme.accent;
                    animate background { duration: 120ms; }
                    accessible-role: button;
                    accessible-label: "Update available: version " + root.update-available + ". Opens the download page.";
                    badge-t := Text {
                        text: "Update " + root.update-available + " available";
                        color: Theme.on-accent;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    badge-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-releases(); }
                    }
                }
            }

            // Body -----------------------------------------------------------
            if root.app-mode == 0: HorizontalLayout {
                // Fade the whole mode in when toggled (created fresh each switch).
                opacity: 0;
                animate opacity { duration: 170ms; easing: ease-out; }
                init => { self.opacity = 1; }
                padding: 16px;
                spacing: 0px;

                // Files card
                Card {
                    width: root.files-w;
                    clip: true;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: "Files";
                            color: Theme.ink;
                            font-size: 15px;
                            font-weight: 700;
                        }

                        // list / empty-state
                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.well;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.line;

                            // empty-state
                            if root.files.length == 0: VerticalLayout {
                                opacity: 0;
                                animate opacity { duration: 200ms; easing: ease-out; }
                                init => { self.opacity = 1; }
                                alignment: center;
                                spacing: 16px;

                                // Minimalist line-art image glyph in the app accent:
                                // a rounded frame with a sun and a mountain.
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 64px;
                                        height: 64px;
                                        border-radius: 14px;
                                        border-width: 2px;
                                        border-color: Theme.accent;
                                        background: transparent;
                                        clip: true;
                                        // sun
                                        Rectangle {
                                            width: 13px;
                                            height: 13px;
                                            border-radius: 7px;
                                            x: 14px;
                                            y: 14px;
                                            background: Theme.accent;
                                        }
                                        // mountains rising from the bottom edge
                                        Path {
                                            width: 64px;
                                            height: 64px;
                                            viewbox-width: 64;
                                            viewbox-height: 64;
                                            fill: Theme.accent;
                                            commands: "M0 64 L24 36 L37 49 L48 32 L64 52 L64 64 Z";
                                        }
                                    }
                                }
                                Text {
                                    text: "Drop images here\nor click Add files…";
                                    color: Theme.muted;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }
                            }

                            // populated list
                            if root.files.length > 0: ListView {
                                // Keep the selected row in view when the selection is
                                // moved from elsewhere (wheel-flipping over the preview):
                                // nudge the viewport just enough to reveal the row.
                                property <int> sel: root.selected-index;
                                changed sel => {
                                    if (self.sel >= 0) {
                                        if (-self.viewport-y > self.sel * Theme.file-row-h) {
                                            self.viewport-y = -self.sel * Theme.file-row-h;
                                        } else if (-self.viewport-y + self.visible-height < (self.sel + 1) * Theme.file-row-h) {
                                            self.viewport-y = -((self.sel + 1) * Theme.file-row-h - self.visible-height);
                                        }
                                    }
                                }
                                for row[i] in root.files: Rectangle {
                                    height: Theme.file-row-h;
                                    background: root.selected-index == i
                                        ? #2dd4bf18
                                        : (row-ta.has-hover ? #262b34 : (Math.mod(i, 2) == 0 ? transparent : #1c2027));
                                    animate background { duration: 120ms; }
                                    accessible-role: list-item;
                                    accessible-label: row.name + (row.dims == "" ? "" : ", " + row.dims) + ", " + row.status;
                                    accessible-item-selected: root.selected-index == i;
                                    // newly added files fade in
                                    opacity: 0;
                                    animate opacity { duration: 160ms; easing: ease-out; }
                                    init => { self.opacity = 1; }
                                    row-ta := TouchArea {
                                        clicked => { root.select-file(i); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 14px;
                                        spacing: 10px;

                                        // thumbnail with a subtle rounded backing
                                        Rectangle {
                                            width: 40px;
                                            height: 40px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 6px;
                                            background: Theme.well;
                                            border-width: 1px;
                                            border-color: Theme.line;
                                            clip: true;
                                            Image {
                                                source: row.thumb;
                                                width: 40px;
                                                height: 40px;
                                                image-fit: contain;
                                            }
                                        }

                                        Text {
                                            text: row.name;
                                            color: Theme.ink;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.dims;
                                            color: Theme.muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            visible: row.cropped;
                                            height: 16px; border-radius: 999px; background: Theme.accent;
                                            y: (parent.height - self.height) / 2;
                                            HorizontalLayout {
                                                padding-left: 6px; padding-right: 6px;
                                                Text { text: "crop"; color: Theme.on-accent; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                                            }
                                        }
                                        // Output size + change, once the file is done.
                                        if row.result != "" : Text {
                                            text: row.result;
                                            color: Theme.accent;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            opacity: 0;
                                            animate opacity { duration: 200ms; }
                                            init => { self.opacity = 1; }
                                        }
                                        Text {
                                            text: row.status;
                                            color: row.status == "done"
                                                ? Theme.accent
                                                : (row.status == "error" ? Theme.danger : Theme.muted);
                                            // queued → done/error fades instead of flicking
                                            animate color { duration: 250ms; }
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                        // Per-row remove (hover-revealed; never during a run).
                                        RemoveButton {
                                            y: (parent.height - self.height) / 2;
                                            label: "Remove " + row.name;
                                            shown: row-ta.has-hover;
                                            enabled: !root.running;
                                            clicked => { root.remove-file(i); }
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            SecondaryButton {
                                text: "Add files…";
                                enabled: !root.running;
                                clicked => { root.add-files(); }
                            }
                            SecondaryButton {
                                text: "Clear";
                                enabled: !root.running;
                                clicked => { root.clear-files(); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                // Lower bound = the Files list's content width; upper bound keeps the
                // viewer at >= its min so nothing is squeezed off-screen.
                Splitter { dragged(dx) => {
                    root.files-w = Math.clamp(root.files-w + dx, 200px, root.width - root.settings-w - 296px);
                } }

                // Viewer card
                Card {
                    min-width: 240px;
                    horizontal-stretch: 1;
                    clip: true;
                    VerticalLayout {
                        padding: 12px; spacing: 8px;

                        Text { text: "Preview"; color: Theme.ink; font-size: 15px; font-weight: 700; }

                        // Toolbar: View/Crop toggle + (when cropping) numeric crop
                        // controls and the aspect-lock button.
                        HorizontalLayout {
                            height: 28px;
                            spacing: 8px;

                            // View / Crop segmented toggle. Selecting Crop enters crop
                            // mode; selecting View applies the current crop then exits.
                            SegToggle {
                                width: 132px;
                                labels: ["View", "Crop"];
                                selected: root.cropping ? 1 : 0;
                                select(i) => {
                                    if (i == 0) {
                                        if (root.cropping) { root.apply-crop(); }
                                        root.cropping = false;
                                    } else {
                                        root.cropping = true;
                                    }
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.cropping : HorizontalLayout {
                                opacity: 0;
                                animate opacity { duration: 160ms; easing: ease-out; }
                                init => { self.opacity = 1; }
                                spacing: 6px;
                                NumberDropdown { label: "X"; value: round(root.crop-x * root.crop-img-w); maximum: root.crop-img-w - 1;
                                    edited(v) => { root.crop-x = Math.clamp(v / Math.max(root.crop-img-w, 1), 0.0, 1.0 - root.crop-w); } }
                                NumberDropdown { label: "Y"; value: round(root.crop-y * root.crop-img-h); maximum: root.crop-img-h - 1;
                                    edited(v) => { root.crop-y = Math.clamp(v / Math.max(root.crop-img-h, 1), 0.0, 1.0 - root.crop-h); } }
                                NumberDropdown { label: "W"; value: round(root.crop-w * root.crop-img-w); minimum: 1; maximum: root.crop-img-w;
                                    edited(v) => { root.crop-w = Math.clamp(v / Math.max(root.crop-img-w, 1), 0.0, 1.0 - root.crop-x); } }
                                NumberDropdown { label: "H"; value: round(root.crop-h * root.crop-img-h); minimum: 1; maximum: root.crop-img-h;
                                    edited(v) => { root.crop-h = Math.clamp(v / Math.max(root.crop-img-h, 1), 0.0, 1.0 - root.crop-y); } }
                                Rectangle {
                                    width: 26px; border-radius: 6px;
                                    background: root.aspect-lock ? Theme.accent : (lock-ta.has-hover ? #1b202a : Theme.window);
                                    border-width: 1px;
                                    border-color: root.aspect-lock ? Theme.accent : (lock-ta.has-hover ? #46505f : Theme.line2);
                                    animate background, border-color { duration: 120ms; }
                                    // SVG (not an emoji glyph, which renders as tofu in
                                    // Slint) tinted to the active/idle state.
                                    Image {
                                        source: @image-url("../assets/ic_lock.svg");
                                        colorize: root.aspect-lock ? Theme.on-accent : Theme.muted;
                                        animate colorize { duration: 120ms; }
                                        width: 13px; height: 13px;
                                    }
                                    lock-ta := TouchArea { clicked => { root.aspect-lock = !root.aspect-lock; } }
                                }
                            }
                        }

                        // Crop surface: hosts the preview and the inline crop editor.
                        // The crop math works in the box-w/h coordinate system: the
                        // crop UI is rendered as a CENTERED region of exactly
                        // box-w × box-h px, the largest image-aspect box that fits
                        // the surface (so a maximised window gets a big editor and
                        // a small image is scaled up to be workable).
                        crop-surface := Rectangle {
                            vertical-stretch: 1;
                            background: #0b0d11;
                            border-radius: 8px;
                            border-width: 1.5px;
                            border-color: Theme.accent;
                            clip: true;

                            property <float> avail-w: Math.max(1, (self.width - 24px) / 1px);
                            property <float> avail-h: Math.max(1, (self.height - 24px) / 1px);
                            property <float> img-ar: root.crop-img-h > 0 && root.crop-img-w > 0
                                ? root.crop-img-w * 1.0 / root.crop-img-h : 4.0 / 3.0;
                            property <bool> fit-h: (self.avail-w / self.avail-h) > self.img-ar;
                            property <float> box-w: self.fit-h ? self.avail-h * self.img-ar : self.avail-w;
                            property <float> box-h: self.fit-h ? self.avail-h : self.avail-w / self.img-ar;

                            // Minimum normalized rect size, so a rectangle can't collapse.
                            property <float> min-n: 0.03;

                            // Drag bookkeeping for moving the whole rectangle.
                            property <length> move-sx;
                            property <length> move-sy;
                            property <float> move-x0;
                            property <float> move-y0;

                            // Edge values captured at the start of a corner drag.
                            property <float> edge-l;
                            property <float> edge-t;
                            property <float> edge-r;
                            property <float> edge-b;
                            // Aspect ratio (w:h in box pixels) captured for aspect-lock resizing.
                            property <float> edge-ratio;

                            function begin-corner() {
                                self.edge-l = root.crop-x;
                                self.edge-t = root.crop-y;
                                self.edge-r = root.crop-x + root.crop-w;
                                self.edge-b = root.crop-y + root.crop-h;
                                self.edge-ratio = (root.crop-w * crop-surface.box-w) / (root.crop-h * crop-surface.box-h);
                            }

                            // Apply a corner drag. sgx/sgy pick which edges move (-1 left/top, +1 right/bottom).
                            function corner(sgx: float, sgy: float, dx: float, dy: float) {
                                // Horizontal edge.
                                if (sgx < 0) {
                                    self.edge-l = Math.clamp(self.edge-l + dx, 0, self.edge-r - self.min-n);
                                } else {
                                    self.edge-r = Math.clamp(self.edge-r + dx, self.edge-l + self.min-n, 1);
                                }
                                // Vertical edge.
                                if (sgy < 0) {
                                    self.edge-t = Math.clamp(self.edge-t + dy, 0, self.edge-b - self.min-n);
                                } else {
                                    self.edge-b = Math.clamp(self.edge-b + dy, self.edge-t + self.min-n, 1);
                                }

                                root.crop-x = self.edge-l;
                                root.crop-y = self.edge-t;
                                root.crop-w = self.edge-r - self.edge-l;
                                root.crop-h = self.edge-b - self.edge-t;

                                if (root.aspect-lock && self.edge-ratio > 0) {
                                    // Recompute height from width to preserve the on-screen aspect:
                                    // crop-w*box-w : crop-h*box-h == edge-ratio. Solve for crop-h.
                                    root.crop-h = (root.crop-w * crop-surface.box-w) / (self.edge-ratio * crop-surface.box-h);
                                    // Grow/shrink from the anchored corner (the edge that did NOT move).
                                    if (sgy < 0) {
                                        root.crop-y = self.edge-b - root.crop-h;
                                    }
                                    // Clamp the derived height into bounds; if it overflows, fall back
                                    // to a height that fits and re-anchor.
                                    if (root.crop-y < 0) {
                                        root.crop-y = 0;
                                        root.crop-h = self.edge-b;
                                    }
                                    if (root.crop-y + root.crop-h > 1) {
                                        root.crop-h = 1 - root.crop-y;
                                    }
                                }
                            }

                            // Mouse wheel over the preview flips through the images,
                            // photo-viewer style. Touchpads deliver many small deltas,
                            // so accumulate and step once per notch-worth (24px);
                            // declared before the preview/crop elements so the crop
                            // editor's own touch areas stack above it.
                            TouchArea {
                                property <length> acc: 0;
                                scroll-event(e) => {
                                    if (root.cropping || root.files.length == 0) {
                                        return reject;
                                    }
                                    self.acc += e.delta-y;
                                    if (self.acc <= -24px) {
                                        self.acc = 0;
                                        if (root.selected-index < root.files.length - 1) {
                                            root.select-file(root.selected-index + 1);
                                        }
                                    } else if (self.acc >= 24px) {
                                        self.acc = 0;
                                        if (root.selected-index > 0) {
                                            root.select-file(root.selected-index - 1);
                                        } else if (root.selected-index < 0) {
                                            root.select-file(0);
                                        }
                                    }
                                    return accept;
                                }
                            }

                            if root.selected-index < 0: Text {
                                text: "Select a file to preview";
                                color: Theme.hint; font-size: 13px;
                                horizontal-alignment: center; vertical-alignment: center;
                                opacity: 0;
                                animate opacity { duration: 200ms; easing: ease-out; }
                                init => { self.opacity = 1; }
                            }

                            // Plain preview when not cropping.
                            if root.selected-index >= 0 && !root.cropping: Image {
                                source: root.viewer-image;
                                image-fit: contain;
                                width: 100%; height: 100%;
                                // Fades in when the first selection lands / crop exits.
                                opacity: 0;
                                animate opacity { duration: 180ms; easing: ease-out; }
                                init => { self.opacity = 1; }
                            }

                            // Inline crop editor: a centered crop-box-w × crop-box-h
                            // region holding the image, with the modal's dim strips,
                            // crop rectangle, move handle and four corner handles —
                            // ported verbatim (parent-overlay → crop-surface).
                            if root.selected-index >= 0 && root.cropping: cbox := Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: crop-surface.box-w * 1px;
                                height: crop-surface.box-h * 1px;
                                border-radius: 6px;
                                clip: true;
                                opacity: 0;
                                animate opacity { duration: 160ms; easing: ease-out; }
                                init => { self.opacity = 1; }

                                Image {
                                    source: root.viewer-image;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: fill;
                                }

                                // Dim overlay outside the crop selection (four strips).
                                Rectangle { x: 0; y: 0; width: parent.width; height: root.crop-y * parent.height; background: #00000099; }
                                Rectangle { x: 0; y: (root.crop-y + root.crop-h) * parent.height; width: parent.width; height: parent.height - (root.crop-y + root.crop-h) * parent.height; background: #00000099; }
                                Rectangle { x: 0; y: root.crop-y * parent.height; width: root.crop-x * parent.width; height: root.crop-h * parent.height; background: #00000099; }
                                Rectangle { x: (root.crop-x + root.crop-w) * parent.width; y: root.crop-y * parent.height; width: parent.width - (root.crop-x + root.crop-w) * parent.width; height: root.crop-h * parent.height; background: #00000099; }

                                // The crop rectangle border + move handle.
                                crect := Rectangle {
                                    x: root.crop-x * parent.width;
                                    y: root.crop-y * parent.height;
                                    width: root.crop-w * parent.width;
                                    height: root.crop-h * parent.height;
                                    border-width: 2px;
                                    border-color: Theme.accent;

                                    cmove-ta := TouchArea {
                                        mouse-cursor: move;
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down) {
                                                crop-surface.move-sx = self.mouse-x;
                                                crop-surface.move-sy = self.mouse-y;
                                                crop-surface.move-x0 = root.crop-x;
                                                crop-surface.move-y0 = root.crop-y;
                                            }
                                        }
                                        moved => {
                                            root.crop-x = Math.clamp(
                                                crop-surface.move-x0 + (self.mouse-x - crop-surface.move-sx) / (crop-surface.box-w * 1px),
                                                0, 1 - root.crop-w);
                                            root.crop-y = Math.clamp(
                                                crop-surface.move-y0 + (self.mouse-y - crop-surface.move-sy) / (crop-surface.box-h * 1px),
                                                0, 1 - root.crop-h);
                                        }
                                    }
                                }

                                // Four corner resize handles. Inset so the full handle
                                // stays visible at each corner. Each reports normalized
                                // drag deltas.
                                CropHandle {
                                    x: root.crop-x * cbox.width;
                                    y: root.crop-y * cbox.height;
                                    box-w: crop-surface.box-w; box-h: crop-surface.box-h;
                                    sign-x: -1; sign-y: -1;
                                    pressed => { crop-surface.begin-corner(); }
                                    dragged(dx, dy) => { crop-surface.corner(-1, -1, dx, dy); }
                                }
                                CropHandle {
                                    x: (root.crop-x + root.crop-w) * cbox.width - self.width;
                                    y: root.crop-y * cbox.height;
                                    box-w: crop-surface.box-w; box-h: crop-surface.box-h;
                                    sign-x: 1; sign-y: -1;
                                    pressed => { crop-surface.begin-corner(); }
                                    dragged(dx, dy) => { crop-surface.corner(1, -1, dx, dy); }
                                }
                                CropHandle {
                                    x: root.crop-x * cbox.width;
                                    y: (root.crop-y + root.crop-h) * cbox.height - self.height;
                                    box-w: crop-surface.box-w; box-h: crop-surface.box-h;
                                    sign-x: -1; sign-y: 1;
                                    pressed => { crop-surface.begin-corner(); }
                                    dragged(dx, dy) => { crop-surface.corner(-1, 1, dx, dy); }
                                }
                                CropHandle {
                                    x: (root.crop-x + root.crop-w) * cbox.width - self.width;
                                    y: (root.crop-y + root.crop-h) * cbox.height - self.height;
                                    box-w: crop-surface.box-w; box-h: crop-surface.box-h;
                                    sign-x: 1; sign-y: 1;
                                    pressed => { crop-surface.begin-corner(); }
                                    dragged(dx, dy) => { crop-surface.corner(1, 1, dx, dy); }
                                }
                            }
                        }
                    }
                }

                // Lower bound = the Settings form's content width (the widest row is
                // the "Save to a subfolder…" label); upper bound keeps the viewer alive.
                Splitter { dragged(dx) => {
                    root.settings-w = Math.clamp(root.settings-w - dx, 330px, root.width - root.files-w - 296px);
                } }

                // Settings card
                Card {
                    width: root.settings-w;
                    clip: true;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text {
                            text: "Settings";
                            color: Theme.ink;
                            font-size: 15px;
                            font-weight: 700;
                        }

                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel { text: "PRESET"; }
                            HorizontalLayout {
                                spacing: 6px;
                                ComboBox {
                                    horizontal-stretch: 1;
                                    model: root.preset-names;
                                    current-index <=> root.current-preset;
                                    selected => { root.preset-changed(self.current-index); }
                                }
                                // Reorder: the Explorer submenu lists presets in this order.
                                SecondaryButton {
                                    text: "▲";
                                    min-width: 34px;
                                    enabled: root.current-preset > 0;
                                    accessible-label: "Move preset up";
                                    clicked => { root.move-preset(-1); }
                                }
                                SecondaryButton {
                                    text: "▼";
                                    min-width: 34px;
                                    enabled: root.current-preset >= 0 && root.current-preset < root.preset-names.length - 1;
                                    accessible-label: "Move preset down";
                                    clicked => { root.move-preset(1); }
                                }
                            }
                            // Save stores the current settings under this name (a new
                            // preset, or an update of the one with that name); Rename
                            // gives the selected preset this name without touching it.
                            LineEdit {
                                placeholder-text: "Preset name";
                                text <=> root.preset-name;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                SecondaryButton {
                                    text: "Save";
                                    horizontal-stretch: 1;
                                    clicked => { root.save-preset(root.preset-name); }
                                }
                                SecondaryButton {
                                    text: "Rename";
                                    horizontal-stretch: 1;
                                    clicked => { root.rename-preset(root.preset-name); }
                                }
                                SecondaryButton {
                                    text: "Delete";
                                    horizontal-stretch: 1;
                                    clicked => { root.confirm-delete = true; }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel { text: "FORMAT"; }
                            ComboBox {
                                model: ["png", "jpeg", "webp", "bmp", "tiff", "gif"];
                                current-value <=> root.format;
                            }
                        }

                        // PNG size optimization (only relevant for PNG output).
                        if root.format == "png": VerticalLayout {
                            opacity: 0;
                            animate opacity { duration: 160ms; easing: ease-out; }
                            init => { self.opacity = 1; }
                            spacing: 6px;
                            FieldLabel { text: "PNG OPTIMIZATION"; }
                            ComboBox {
                                model: ["Normal", "Optimize (lossless)", "Compress (lossy · uses quality)"];
                                current-index <=> root.png-mode;
                            }
                        }

                        // Quality only applies to lossy outputs: JPEG, WebP, and PNG
                        // in "Compress (lossy)" mode (png-mode == 2).
                        if root.format == "jpeg" || root.format == "webp"
                            || (root.format == "png" && root.png-mode == 2): VerticalLayout {
                            opacity: 0;
                            animate opacity { duration: 160ms; easing: ease-out; }
                            init => { self.opacity = 1; }
                            spacing: 6px;
                            FieldLabel { text: "QUALITY (\{root.quality})"; }
                            QualitySlider {
                                value <=> root.quality;
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel { text: "RESOLUTION (px)"; }
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    spacing: 2px;
                                    FieldLabel { text: "WIDTH"; }
                                    SpinBox {
                                        minimum: 0;
                                        maximum: 20000;
                                        value <=> root.res-w;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    FieldLabel { text: "HEIGHT"; }
                                    SpinBox {
                                        minimum: 0;
                                        maximum: 20000;
                                        value <=> root.res-h;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                CheckBox {
                                    text: "Keep aspect";
                                    checked <=> root.res-lock;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text {
                                text: "0 = keep preset size";
                                color: Theme.muted;
                                font-size: 11px;
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel { text: "FILE NAME SUFFIX"; }
                            LineEdit {
                                placeholder-text: "e.g. -kuvatin";
                                text <=> root.suffix;
                            }
                            CheckBox {
                                text: "Save to a subfolder (named after the suffix)";
                                checked <=> root.save-subfolder;
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            FieldLabel { text: "UPDATES"; }
                            CheckBox {
                                text: "Check for updates once a day";
                                checked <=> root.update-check-enabled;
                                toggled => { root.update-check-toggled(self.checked); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.update-status;
                                    color: Theme.muted;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if root.update-check-enabled : SecondaryButton {
                                    text: "Check now";
                                    min-width: 84px;
                                    clicked => { root.check-updates-now(); }
                                }
                            }
                        }

                        // spacer pushes the action block to the bottom
                        Rectangle { vertical-stretch: 1; }

                        // Custom bar (matches the import/export bars): glides between
                        // per-file progress steps and fades in when the run starts.
                        if root.running: Rectangle {
                            height: 6px; border-radius: 3px; background: Theme.line;
                            opacity: 0;
                            animate opacity { duration: 150ms; }
                            init => { self.opacity = 1; }
                            Rectangle {
                                x: 0; height: parent.height; border-radius: 3px;
                                width: parent.width * Math.clamp(root.progress, 0, 1);
                                animate width { duration: 220ms; easing: ease-out; }
                                background: @linear-gradient(90deg, #3f7df5 0%, Theme.accent 100%);
                            }
                        }

                        // One button, two jobs: Convert, then Cancel for as long
                        // as the batch runs. Cancel stops the queue after the
                        // file currently being written, so nothing is half-saved.
                        Rectangle {
                            height: 42px;
                            border-radius: 8px;
                            background: root.running
                                ? (convert-ta.pressed || convert-ta.has-hover ? Theme.danger2 : #7a2a33)
                                : (convert-ta.pressed
                                    ? Theme.accent-pressed
                                    : (convert-ta.has-hover ? Theme.accent-pressed : Theme.accent));
                            border-width: convert-fs.has-focus ? 2px : 0px;
                            border-color: #ffffff;
                            animate background { duration: 150ms; }
                            accessible-role: button;
                            accessible-label: root.running ? "Cancel conversion" : "Convert";
                            convert-fs := FocusScope {
                                key-pressed(e) => {
                                    if (e.text == Key.Return || e.text == " ") {
                                        if (root.running) { root.convert-cancel(); } else { root.convert(); }
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            Text {
                                text: root.running ? "Cancel" : "Convert";
                                color: root.running ? #ffffff : Theme.on-accent;
                                animate color { duration: 150ms; }
                                font-size: 14px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            convert-ta := TouchArea {
                                clicked => {
                                    convert-fs.focus();
                                    if (root.running) { root.convert-cancel(); } else { root.convert(); }
                                }
                            }
                        }
                    }
                }
            }
            if root.app-mode == 1: VerticalLayout {
                opacity: 0;
                animate opacity { duration: 170ms; easing: ease-out; }
                init => { self.opacity = 1; }
                spacing: 0px;

                // ===== Main row: media bin · composited viewer + transport · inspector =====
                HorizontalLayout {
                    vertical-stretch: 1;
                    padding: 12px;
                    // Zero spacing: the 12px Splitter is the whole inter-panel gap
                    // (matches the image view's thin handles).
                    spacing: 0px;

                    // Media bin
                    Card {
                        width: root.video-bin-w;
                        clip: true;
                        VerticalLayout {
                            padding: 11px;
                            spacing: 7px;
                            Text { text: "MEDIA"; color: Theme.muted2; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; }
                            Rectangle {
                                vertical-stretch: 1;
                                if root.video-clips.length == 0 : Text {
                                    text: "Open a video or image\nto add it here";
                                    color: Theme.hint; font-size: 11px;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    opacity: 0;
                                    animate opacity { duration: 200ms; easing: ease-out; }
                                    init => { self.opacity = 1; }
                                }
                                if root.video-clips.length > 0 : ListView {
                                    // Click a bin item to add it to the timeline; the ×
                                    // (on hover) removes it from the bin.
                                    for asset[i] in root.video-clips : Rectangle {
                                        height: 33px; border-radius: 7px;
                                        background: asset-ta.has-hover ? #262b34 : transparent;
                                        animate background { duration: 120ms; }
                                        opacity: 0;
                                        animate opacity { duration: 160ms; easing: ease-out; }
                                        init => { self.opacity = 1; }
                                        accessible-role: list-item;
                                        accessible-label: asset.name + ", add to timeline";
                                        asset-ta := TouchArea { clicked => { root.video-add(i); } }
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 8px;
                                            Rectangle {
                                                width: 32px; height: 21px; y: (parent.height - self.height) / 2;
                                                border-radius: 4px; background: Theme.line; clip: true;
                                                border-width: 1px; border-color: #ffffff14;
                                                Image { source: asset.thumb; image-fit: cover; width: 100%; height: 100%; }
                                            }
                                            Text { text: asset.name; color: Theme.ink2; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            Text {
                                                text: "+"; color: Theme.accent; font-size: 18px; font-weight: 700;
                                                vertical-alignment: center; opacity: asset-ta.has-hover ? 1.0 : 0.0;
                                                animate opacity { duration: 130ms; }
                                            }
                                            RemoveButton {
                                                y: (parent.height - self.height) / 2;
                                                label: "Remove " + asset.name + " from the media bin";
                                                shown: asset-ta.has-hover;
                                                clicked => { root.video-bin-removed(i); }
                                            }
                                        }
                                    }
                                }
                            }
                            SecondaryButton { text: "Open media…"; enabled: !root.video-engine-down; clicked => { root.video-open(); } }
                            SecondaryButton { text: "Import sequence…"; enabled: !root.video-engine-down; clicked => { root.video-open-sequence(); } }
                        }
                    }

                    Splitter {
                        dragged(dx) => {
                            root.video-bin-w = Math.clamp(root.video-bin-w + dx, 150px, root.width - root.video-insp-w - 320px);
                        }
                    }

                    // Composited viewer + transport
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 8px;
                        Rectangle {
                            vertical-stretch: 1;
                            background: #000;
                            border-radius: 9px; border-width: 1px; border-color: Theme.line;
                            clip: true;
                            if root.video-frame.width > 0 : Image {
                                source: root.video-frame; image-fit: contain; width: 100%; height: 100%;
                                // the composited preview fades in when the first frame lands
                                opacity: 0;
                                animate opacity { duration: 200ms; easing: ease-out; }
                                init => { self.opacity = 1; }
                            }
                            if root.video-frame.width <= 0 : Text {
                                text: "Add a clip to the timeline to preview";
                                color: Theme.hint; font-size: 13px;
                                horizontal-alignment: center; vertical-alignment: center;
                                opacity: 0;
                                animate opacity { duration: 200ms; easing: ease-out; }
                                init => { self.opacity = 1; }
                            }

                            // Bounding box: move/resize the selected clip on the canvas.
                            // The TouchArea fills the (fixed) viewer for stable drag
                            // deltas; the visible box is derived from insp-* (reactive).
                            if root.inspector-name != "" && root.video-frame.width > 0 : edit-layer := Rectangle {
                                // selection box fades in when a clip becomes selected
                                opacity: 0;
                                animate opacity { duration: 140ms; easing: ease-out; }
                                init => { self.opacity = 1; }
                                // canvas → viewer mapping under image-fit: contain
                                property <bool> hlim: (self.width / self.height) > (root.canvas-w * 1.0 / root.canvas-h);
                                property <length> disp-w: hlim ? self.height * root.canvas-w / root.canvas-h : self.width;
                                property <length> off-x: (self.width - disp-w) / 2;
                                property <length> off-y: (self.height - (hlim ? self.height : self.width * root.canvas-h / root.canvas-w)) / 2;
                                property <length> ppc: disp-w / root.canvas-w;      // viewer px per canvas px
                                property <float> rw: (root.insp-scale / 100) * root.sel-fit-w;   // canvas px
                                property <float> rh: (root.insp-scale / 100) * root.sel-fit-h;
                                property <length> bx: off-x + root.insp-posx * ppc;
                                property <length> by: off-y + root.insp-posy * ppc;
                                property <length> bw: rw * ppc;
                                property <length> bh: rh * ppc;

                                Rectangle {
                                    x: edit-layer.bx; y: edit-layer.by;
                                    width: edit-layer.bw; height: edit-layer.bh;
                                    background: #2dd4bf10;
                                    border-width: 1.5px; border-color: Theme.accent;
                                    Rectangle { x: -4px; y: -4px; width: 9px; height: 9px; background: white; border-width: 1px; border-color: Theme.accent; }
                                    Rectangle { x: parent.width - 5px; y: -4px; width: 9px; height: 9px; background: white; border-width: 1px; border-color: Theme.accent; }
                                    Rectangle { x: -4px; y: parent.height - 5px; width: 9px; height: 9px; background: white; border-width: 1px; border-color: Theme.accent; }
                                    Rectangle { x: parent.width - 5px; y: parent.height - 5px; width: 9px; height: 9px; background: white; border-width: 1px; border-color: Theme.accent; }
                                }

                                eta := TouchArea {
                                    property <EditMode> mode: EditMode.none;
                                    property <float> cen-x: 0;   // canvas center (resize anchor)
                                    property <float> cen-y: 0;
                                    property <float> b-posx: 0;
                                    property <float> b-posy: 0;
                                    mouse-cursor: eta.mode == EditMode.resize ? MouseCursor.nwse-resize : MouseCursor.move;
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) {
                                            eta.b-posx = root.insp-posx;
                                            eta.b-posy = root.insp-posy;
                                            eta.cen-x = root.insp-posx + edit-layer.rw / 2;
                                            eta.cen-y = root.insp-posy + edit-layer.rh / 2;
                                            if (Math.max(Math.abs(self.pressed-x - edit-layer.bx), Math.abs(self.pressed-y - edit-layer.by)) < 16px
                                                || Math.max(Math.abs(self.pressed-x - (edit-layer.bx + edit-layer.bw)), Math.abs(self.pressed-y - edit-layer.by)) < 16px
                                                || Math.max(Math.abs(self.pressed-x - edit-layer.bx), Math.abs(self.pressed-y - (edit-layer.by + edit-layer.bh))) < 16px
                                                || Math.max(Math.abs(self.pressed-x - (edit-layer.bx + edit-layer.bw)), Math.abs(self.pressed-y - (edit-layer.by + edit-layer.bh))) < 16px) {
                                                eta.mode = EditMode.resize;
                                            } else if (self.pressed-x >= edit-layer.bx && self.pressed-x <= edit-layer.bx + edit-layer.bw
                                                && self.pressed-y >= edit-layer.by && self.pressed-y <= edit-layer.by + edit-layer.bh) {
                                                eta.mode = EditMode.move;
                                            } else {
                                                eta.mode = EditMode.none;
                                            }
                                        }
                                        if (ev.kind == PointerEventKind.up) { eta.mode = EditMode.none; }
                                    }
                                    moved => {
                                        if (eta.mode == EditMode.move) {
                                            root.insp-posx = eta.b-posx + (self.mouse-x - self.pressed-x) / edit-layer.ppc;
                                            root.insp-posy = eta.b-posy + (self.mouse-y - self.pressed-y) / edit-layer.ppc;
                                            root.inspector-changed();
                                        } else if (eta.mode == EditMode.resize) {
                                            root.insp-scale = Math.clamp(Math.abs((self.mouse-x - edit-layer.off-x) / edit-layer.ppc - eta.cen-x) * 2 / root.sel-fit-w * 100, 10, 100);
                                            root.insp-posx = eta.cen-x - (root.insp-scale / 100) * root.sel-fit-w / 2;
                                            root.insp-posy = eta.cen-y - (root.insp-scale / 100) * root.sel-fit-h / 2;
                                            root.inspector-changed();
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 30px; spacing: 9px;
                            Rectangle {
                                width: 32px; border-radius: 8px;
                                background: pp-ta.has-hover ? Theme.card : transparent;
                                animate background { duration: 110ms; }
                                accessible-role: button;
                                accessible-label: root.video-playing ? "Pause" : "Play";
                                // Two stacked icons cross-fading beats an instant source swap.
                                Image {
                                    source: @image-url("../assets/ic_play.svg");
                                    colorize: #e6e9ef; width: 15px; height: 15px;
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    opacity: root.video-playing ? 0 : 1;
                                    animate opacity { duration: 120ms; }
                                }
                                Image {
                                    source: @image-url("../assets/ic_pause.svg");
                                    colorize: #e6e9ef; width: 15px; height: 15px;
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    opacity: root.video-playing ? 1 : 0;
                                    animate opacity { duration: 120ms; }
                                }
                                pp-ta := TouchArea { clicked => { root.video-playpause(); } }
                            }
                            // Repeat / loop toggle.
                            Rectangle {
                                width: 32px; border-radius: 8px;
                                background: root.video-repeat ? #2dd4bf22 : (rp-ta.has-hover ? Theme.card : transparent);
                                animate background { duration: 110ms; }
                                accessible-role: button;
                                accessible-label: "Repeat";
                                accessible-checkable: true;
                                accessible-checked: root.video-repeat;
                                Image {
                                    source: @image-url("../assets/ic_repeat.svg");
                                    colorize: root.video-repeat ? Theme.accent : Theme.muted; width: 16px; height: 16px;
                                    animate colorize { duration: 150ms; }
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                }
                                rp-ta := TouchArea { clicked => { root.video-repeat = !root.video-repeat; } }
                            }
                            Text { text: root.video-time; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                            Scrubber { value: root.video-position; changed(f) => { root.video-seek(f); } released => { root.seek-done(); } }
                            Image { source: @image-url("../assets/ic_volume.svg"); colorize: Theme.muted; width: 15px; height: 15px; }
                            Scrubber { width: 70px; label: "Volume"; value: root.video-volume; changed(f) => { root.video-volume-changed(f); } }
                        }
                    }

                    Splitter {
                        dragged(dx) => {
                            root.video-insp-w = Math.clamp(root.video-insp-w - dx, 200px, root.width - root.video-bin-w - 320px);
                        }
                    }

                    // Inspector: edit the selected clip's transform, opacity & volume.
                    Card {
                        width: root.video-insp-w;
                        clip: true;
                        VerticalLayout {
                            padding: 11px;
                            spacing: 9px;
                            // Project canvas (viewport) size — always editable. Click a field
                            // to type an exact size, or pick a preset.
                            Text { text: "CANVAS"; color: Theme.muted2; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; }
                            HorizontalLayout {
                                spacing: 6px;
                                NumberDropdown {
                                    label: "W"; value: root.canvas-w; minimum: 16; maximum: 7680;
                                    edited(v) => { root.set-canvas-size(v, root.canvas-h); }
                                }
                                NumberDropdown {
                                    label: "H"; value: root.canvas-h; minimum: 16; maximum: 4320;
                                    edited(v) => { root.set-canvas-size(root.canvas-w, v); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            ComboBox {
                                model: ["Preset…", "1920 × 1080", "1280 × 720", "1080 × 1920 (vertical)", "1080 × 1080 (square)", "3840 × 2160 (4K)", "854 × 480"];
                                current-index: 0;
                                selected(t) => {
                                    if (self.current-index == 1) { root.set-canvas-size(1920, 1080); }
                                    if (self.current-index == 2) { root.set-canvas-size(1280, 720); }
                                    if (self.current-index == 3) { root.set-canvas-size(1080, 1920); }
                                    if (self.current-index == 4) { root.set-canvas-size(1080, 1080); }
                                    if (self.current-index == 5) { root.set-canvas-size(3840, 2160); }
                                    if (self.current-index == 6) { root.set-canvas-size(854, 480); }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.line; }
                            Text { text: root.inspector-name == "" ? "INSPECTOR" : "LAYER"; color: Theme.muted2; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; }
                            if root.inspector-name == "" : Text {
                                text: "Select a clip to edit its\ntransform, opacity & volume";
                                color: Theme.hint; font-size: 11px; vertical-alignment: center; horizontal-alignment: center;
                                opacity: 0;
                                animate opacity { duration: 180ms; easing: ease-out; }
                                init => { self.opacity = 1; }
                            }
                            if root.inspector-name != "" : Text {
                                text: root.inspector-name; color: Theme.ink; font-size: 13px; font-weight: 600;
                                overflow: elide;
                                opacity: 0;
                                animate opacity { duration: 180ms; easing: ease-out; }
                                init => { self.opacity = 1; }
                            }
                            if root.inspector-name != "" : VerticalLayout {
                                opacity: 0;
                                animate opacity { duration: 180ms; easing: ease-out; }
                                init => { self.opacity = 1; }
                                spacing: 6px;
                                InspSlider { label: "Position X"; min: -root.canvas-w; max: root.canvas-w; suffix: "px"; value <=> root.insp-posx; changed => { root.inspector-changed(); } }
                                InspSlider { label: "Position Y"; min: -root.canvas-h; max: root.canvas-h; suffix: "px"; value <=> root.insp-posy; changed => { root.inspector-changed(); } }
                                InspSlider { label: "Scale"; min: 10; max: 100; suffix: "%"; value <=> root.insp-scale; changed => { root.inspector-changed(); } }
                                InspSlider { label: "Opacity"; min: 0; max: 100; suffix: "%"; value <=> root.insp-alpha; changed => { root.inspector-changed(); } }
                                if root.insp-has-audio : InspSlider { label: "Volume"; min: 0; max: 100; suffix: "%"; value <=> root.insp-volume; changed => { root.inspector-changed(); } }
                                // A still has no source length, so its duration is a free
                                // choice; a real clip's is set by trimming on the timeline.
                                if root.insp-is-still : VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        Text { text: "Duration"; color: Theme.muted2; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: root.insp-duration-s + " s"; color: #cfd6e2; font-size: 9.5px; font-weight: 600; vertical-alignment: center; }
                                    }
                                    SpinBox {
                                        minimum: 1;
                                        maximum: 3600;
                                        value <=> root.insp-duration-s;
                                        accessible-label: "Duration in seconds";
                                        edited(v) => { root.inspector-duration-changed(v); }
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }

                // ===== Timeline band =====
                Rectangle {
                    // Sized to the tracks + one "new track" drop row with breathing
                    // room below it (so a clip dragged onto the row stays fully visible).
                    height: Math.max(140px, root.timeline-track-labels.length * root.track-h + 82px);
                    background: #101319;
                    border-width: 1px; border-color: Theme.line;
                    VerticalLayout {
                        spacing: 0px;

                        // toolbar
                        Rectangle {
                            height: 26px; background: #13161c;
                            HorizontalLayout {
                                padding-left: 11px; padding-right: 8px; spacing: 8px;
                                Text { text: "TIMELINE"; color: Theme.muted2; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: "drag clips to arrange"; color: #5e6675; font-size: 9px; vertical-alignment: center; }
                                exp-btn := Rectangle {
                                    // Nothing to export from an empty timeline (or a dead engine).
                                    property <bool> can-export: root.timeline-clips.length > 0 && !root.video-engine-down;
                                    width: 74px; y: (parent.height - self.height) / 2; height: 22px;
                                    border-radius: 5px;
                                    background: !self.can-export ? #1d3f3a : (exp-ta.has-hover ? Theme.accent : Theme.accent2);
                                    animate background { duration: 120ms; }
                                    accessible-role: button;
                                    accessible-label: "Export";
                                    accessible-enabled: self.can-export;
                                    Text {
                                        text: "Export"; color: exp-btn.can-export ? Theme.on-accent : Theme.disabled-ink; font-size: 10px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    // Open the export settings dialog, defaulting the output
                                    // size to the current canvas.
                                    exp-ta := TouchArea {
                                        enabled: exp-btn.can-export;
                                        mouse-cursor: exp-btn.can-export ? MouseCursor.pointer : MouseCursor.not-allowed;
                                        clicked => {
                                            root.export-w = root.canvas-w;
                                            root.export-h = root.canvas-h;
                                            root.export-config = true;
                                        }
                                    }
                                }
                            }
                        }

                        // rows: gutter (track headers) + lane area
                        HorizontalLayout {
                            vertical-stretch: 1;

                            VerticalLayout {
                                width: 94px;
                                // Drag a header up/down to reorder tracks.
                                for lbl[t] in root.timeline-track-labels : hdr := Rectangle {
                                    height: root.track-h;
                                    background: hta.pressed ? Theme.card : #13161c;
                                    animate background { duration: 100ms; }
                                    border-width: 1px; border-color: #181c23;
                                    property <length> ddy: 0px;
                                    HorizontalLayout {
                                        padding-left: 9px; spacing: 6px;
                                        Text { text: "≡"; color: hta.has-hover ? Theme.muted2 : #5e6675; font-size: 11px; vertical-alignment: center; animate color { duration: 120ms; } }
                                        Text { text: lbl; color: Theme.muted2; font-size: 9px; vertical-alignment: center; overflow: elide; }
                                    }
                                    hta := TouchArea {
                                        mouse-cursor: ns-resize;
                                        moved => { hdr.ddy = self.mouse-y - self.pressed-y; }
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.up) {
                                                if (Math.abs(hdr.ddy / 1px) > 15) {
                                                    root.track-reordered(t, Math.clamp(t + Math.round(hdr.ddy / root.track-h), 0, root.timeline-track-labels.length - 1));
                                                }
                                                hdr.ddy = 0px;
                                            }
                                            // Reset stale drag on cancel, else the next plain
                                            // click could fire a spurious reorder.
                                            if (ev.kind == PointerEventKind.cancel) { hdr.ddy = 0px; }
                                        }
                                    }
                                }
                            }

                            lane := Rectangle {
                                horizontal-stretch: 1;
                                clip: true;
                                background: #0e1116;
                                // Horizontal scroll: content width vs the visible lane.
                                property <length> content-w: (root.timeline-duration * root.timeline-pps) * 1px + 40px;
                                property <length> max-scroll: max(0px, self.content-w - self.width);
                                property <length> scroll: Math.clamp(root.tl-scroll, 0px, self.max-scroll);

                                // Scrub: click/drag empty timeline area to move the
                                // playhead and seek. Behind the clips, so clip clicks
                                // still select and clip drags still move.
                                scrub-ta := TouchArea {
                                    function seek(mx: length) {
                                        root.timeline-seek-time(Math.max(0, (mx + lane.scroll) / 1px / root.timeline-pps));
                                    }
                                    moved => { scrub-ta.seek(self.mouse-x); }
                                    pointer-event(ev) => {
                                        if (ev.kind == PointerEventKind.down) { scrub-ta.seek(self.mouse-x); }
                                        if (ev.kind == PointerEventKind.up) { root.seek-done(); }
                                    }
                                }

                                // row background stripes (fixed; span the visible lane)
                                VerticalLayout {
                                    for lbl[t] in root.timeline-track-labels : Rectangle { height: root.track-h; border-width: 1px; border-color: #181c23; }
                                }

                                // clip blocks. The wrapper `blk` keeps the clip's MODEL
                                // geometry (fixed during a drag) so the hit-areas sit in a
                                // stable frame; `vis` is the visual block that moves/resizes
                                // live from the pointer delta. dmode says which (DragMode).
                                for clip[i] in root.timeline-clips : blk := Rectangle {
                                    x: (clip.start * root.timeline-pps) * 1px - lane.scroll;
                                    // track 0 = GES layer 0 = top (both on-screen and composited).
                                    y: clip.track * root.track-h + 4px;
                                    width: (clip.duration * root.timeline-pps) * 1px;
                                    height: 22px;
                                    background: transparent;
                                    // a clip dropped onto the timeline fades in
                                    opacity: 0;
                                    animate opacity { duration: 180ms; easing: ease-out; }
                                    init => { self.opacity = 1; }
                                    property <length> ddx: 0px;
                                    property <length> ddy: 0px;
                                    property <DragMode> dmode: DragMode.idle;

                                    // live visual (previews the drag; not a drag frame)
                                    vis := Rectangle {
                                        // Snapped horizontal slide (DragMode.slide): the snap callback nudges
                                        // the nearest edge onto a neighbouring clip edge or the timeline
                                        // start. Left-trim (DragMode.trim-left) tracks the raw pointer.
                                        property <float> snap-dx-s: root.timeline-snap-dx(i, blk.ddx / 1px / root.timeline-pps, root.timeline-pps);
                                        x: blk.dmode == DragMode.slide ? (self.snap-dx-s * root.timeline-pps * 1px)
                                            : (blk.dmode == DragMode.trim-left ? blk.ddx : 0px);
                                        // Vertical: magnetically snap to the nearest track lane, clamped
                                        // to the ACTUAL visible lane so the block can never slide past the
                                        // (possibly compressed) bottom and vanish. The drop TARGET below
                                        // still uses the raw delta, so dropping past the last track adds one.
                                        y: blk.dmode == DragMode.slide
                                            ? Math.clamp(Math.round(blk.ddy / root.track-h) * root.track-h, -blk.y, lane.height - blk.height - blk.y - 2px)
                                            : 0px;
                                        // "Mass" + magnetic settle: ease toward the (snapped) target with a
                                        // slight overshoot instead of tracking the cursor 1:1. Instant when
                                        // not sliding so the drop commit itself doesn't animate.
                                        animate x { duration: blk.dmode == DragMode.slide ? 75ms : 0ms; easing: cubic-bezier(0.25, 0.9, 0.3, 1.05); }
                                        animate y { duration: blk.dmode == DragMode.slide ? 95ms : 0ms; easing: cubic-bezier(0.25, 0.9, 0.3, 1.07); }
                                        width: max(10px, parent.width
                                            + (blk.dmode == DragMode.trim-left ? -blk.ddx : 0px)
                                            + (blk.dmode == DragMode.trim-right ? blk.ddx : 0px));
                                        height: parent.height;
                                        border-radius: 6px;
                                        clip: true;
                                        background: clip.kind == ClipKind.video
                                            ? @linear-gradient(135deg, #3f7df5 0%, #1f4fc0 100%)
                                            : clip.kind == ClipKind.sequence
                                                ? @linear-gradient(135deg, #8b5cf6 0%, #5b34c9 100%)
                                                : @linear-gradient(135deg, #1fd3b6 0%, #0f9d84 100%);
                                        border-width: clip.selected ? 2px : 1px;
                                        border-color: clip.selected ? Theme.accent : #00000055;
                                        animate border-color { duration: 130ms; }
                                        // thumbnail (covers the gradient once generated)
                                        Image { source: clip.thumb; image-fit: cover; width: 100%; height: 100%; }
                                        // left scrim so the name stays legible over the thumb
                                        Rectangle { x: 0; width: 62%; background: @linear-gradient(90deg, #000000bb 0%, #00000000 100%); }
                                        Text { text: clip.name; color: white; font-size: 9px; font-weight: 700; x: 9px; y: (parent.height - self.height) / 2; }
                                        Rectangle { x: 0; width: 5px; height: parent.height; background: #ffffffcc; }
                                        Rectangle { x: parent.width - 5px; width: 5px; height: parent.height; background: #ffffffcc; }
                                        // Delete affordance on the selected clip (also Delete key).
                                        // The visible square is 16 px; the hit area spans the
                                        // clip's full height and 24 px of width.
                                        if clip.selected : Rectangle {
                                            x: parent.width - self.width - 3px; y: 3px;
                                            width: 16px; height: 16px; border-radius: 5px;
                                            background: del-ta.has-hover ? Theme.danger2 : #00000088;
                                            animate background { duration: 100ms; }
                                            opacity: 0;
                                            animate opacity { duration: 140ms; }
                                            init => { self.opacity = 1; }
                                            accessible-role: button;
                                            accessible-label: "Remove " + clip.name + " from the timeline";
                                            Text { text: "✕"; color: white; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                            del-ta := TouchArea {
                                                x: -6px; y: -3px; width: 24px; height: 22px;
                                                clicked => { root.timeline-clip-removed(i); }
                                            }
                                        }
                                    }

                                    // body: slide (horizontal) + move to another track
                                    // (vertical) + select. Stable frame = blk.
                                    TouchArea {
                                        mouse-cursor: move;
                                        moved => {
                                            blk.dmode = DragMode.slide;
                                            blk.ddx = self.mouse-x - self.pressed-x;
                                            blk.ddy = self.mouse-y - self.pressed-y;
                                            root.clip-dragging = true;
                                            root.clip-drag-target-row = clip.track + Math.round(blk.ddy / root.track-h);
                                        }
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.up) {
                                                if (blk.dmode == DragMode.slide && (Math.abs(blk.ddx / 1px) > 2 || Math.abs(blk.ddy / 1px) > 2)) {
                                                    // Commit the SNAPPED slide so the clip lands exactly
                                                    // where it magnetically settled, not at the raw cursor.
                                                    root.timeline-clip-dropped(i, root.timeline-snap-dx(i, blk.ddx / 1px / root.timeline-pps, root.timeline-pps), Math.round(blk.ddy / root.track-h));
                                                }
                                                blk.dmode = DragMode.idle; blk.ddx = 0px; blk.ddy = 0px;
                                                root.clip-dragging = false;
                                            }
                                            // A cancelled grab (window deactivation, grab stolen)
                                            // must reset too, or the drop banner stays stuck.
                                            if (ev.kind == PointerEventKind.cancel) {
                                                blk.dmode = DragMode.idle; blk.ddx = 0px; blk.ddy = 0px;
                                                root.clip-dragging = false;
                                            }
                                        }
                                        clicked => { root.timeline-select(i); }
                                    }
                                    // left-edge trim (on top of the body); 12 px grips
                                    Rectangle {
                                        x: 0; width: 12px; height: parent.height; background: transparent;
                                        TouchArea {
                                            mouse-cursor: ew-resize;
                                            moved => { blk.dmode = DragMode.trim-left; blk.ddx = self.mouse-x - self.pressed-x; }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.up) {
                                                    if (blk.dmode == DragMode.trim-left && Math.abs(blk.ddx / 1px) > 2) {
                                                        root.timeline-clip-trimmed(i, -1, (blk.ddx / 1px) / root.timeline-pps);
                                                    }
                                                    blk.dmode = DragMode.idle; blk.ddx = 0px;
                                                }
                                                if (ev.kind == PointerEventKind.cancel) { blk.dmode = DragMode.idle; blk.ddx = 0px; }
                                            }
                                        }
                                    }
                                    // right-edge trim
                                    Rectangle {
                                        x: parent.width - 12px; width: 12px; height: parent.height; background: transparent;
                                        TouchArea {
                                            mouse-cursor: ew-resize;
                                            moved => { blk.dmode = DragMode.trim-right; blk.ddx = self.mouse-x - self.pressed-x; }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.up) {
                                                    if (blk.dmode == DragMode.trim-right && Math.abs(blk.ddx / 1px) > 2) {
                                                        root.timeline-clip-trimmed(i, 1, (blk.ddx / 1px) / root.timeline-pps);
                                                    }
                                                    blk.dmode = DragMode.idle; blk.ddx = 0px;
                                                }
                                                if (ev.kind == PointerEventKind.cancel) { blk.dmode = DragMode.idle; blk.ddx = 0px; }
                                            }
                                        }
                                    }
                                }

                                // playhead — the 90ms linear animate interpolates the
                                // ~100ms position poll into a continuous glide.
                                Rectangle {
                                    x: (root.playhead * root.timeline-pps) * 1px - lane.scroll;
                                    animate x { duration: 90ms; easing: linear; }
                                    width: 2px; height: parent.height;
                                    background: Theme.danger2;
                                }

                                // horizontal scrollbar (only when the timeline overflows)
                                if lane.max-scroll > 0px : Rectangle {
                                    y: parent.height - 11px; x: 4px; width: parent.width - 8px; height: 7px;
                                    border-radius: 3px; background: #00000080;
                                    property <length> thumb-w: max(36px, self.width * self.width / lane.content-w);
                                    Rectangle {
                                        x: (lane.scroll / lane.max-scroll) * (parent.width - parent.thumb-w);
                                        width: parent.thumb-w; height: parent.height;
                                        border-radius: 3px;
                                        background: sbta.pressed ? Theme.accent : (sbta.has-hover ? #ffffff66 : #ffffff40);
                                        animate background { duration: 120ms; }
                                    }
                                    sbta := TouchArea {
                                        function set(mx: length) {
                                            root.tl-scroll = Math.clamp((mx - parent.thumb-w / 2) / (parent.width - parent.thumb-w) * lane.max-scroll, 0px, lane.max-scroll);
                                        }
                                        moved => { sbta.set(self.mouse-x); }
                                        pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { sbta.set(self.mouse-x); } }
                                    }
                                }

                                // Persistent "new track" row, just below the last track.
                                // Subtle when idle; teal while dragging a clip; bright teal
                                // when the drag targets it. Topmost so nothing can hide it.
                                // Semi-transparent while active so the resting clip shows
                                // through. A dashed-look border keeps it reading as a drop
                                // zone. Sits above the scrollbar with room to spare.
                                Rectangle {
                                    property <bool> active: root.clip-drag-target-row >= root.timeline-track-labels.length;
                                    y: root.timeline-track-labels.length * root.track-h + 4px;
                                    animate y { duration: 160ms; easing: ease-out; }
                                    x: 4px; width: parent.width - 8px; height: 26px;
                                    border-radius: 7px;
                                    background: root.clip-dragging
                                        ? (active ? #2dd4bfcc : #16342ee0)
                                        : (nt-ta.has-hover ? #ffffff14 : #ffffff08);
                                    border-width: root.clip-dragging ? 2px : 1px;
                                    border-color: root.clip-dragging
                                        ? (active ? #ffffff : Theme.accent)
                                        : (nt-ta.has-hover ? #2dd4bf88 : #ffffff1f);
                                    animate background, border-color { duration: 140ms; }
                                    Text {
                                        text: root.clip-dragging ? "+  Drop here for a new track" : "+  New track";
                                        color: root.clip-dragging
                                            ? (active ? Theme.on-accent : #8bf0e2)
                                            : (nt-ta.has-hover ? #8bf0e2 : Theme.hint);
                                        animate color { duration: 140ms; }
                                        font-size: 10.5px; font-weight: 700;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    // Click to add an empty track row (drops still work as before).
                                    nt-ta := TouchArea {
                                        enabled: !root.clip-dragging;
                                        mouse-cursor: pointer;
                                        clicked => { root.add-track(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Drop-zone indicator shown while dragging a timeline clip. Rendered at the
        // Window level (a sibling of the modals) so it can NEVER be clipped by the
        // timeline lane or hidden behind the band — the in-lane row proved unreliable.
        // It's purely a visual affordance: the drop target is decided by drag distance,
        // so the banner doesn't need to sit directly under the cursor.
        if root.clip-dragging : Rectangle {
            property <bool> active: root.clip-drag-target-row >= root.timeline-track-labels.length;
            property <length> band-h: Math.max(140px, root.timeline-track-labels.length * root.track-h + 82px);
            // Entrance: fade + rise so the banner glides in instead of popping.
            property <length> rise: 10px;
            opacity: 0;
            animate opacity { duration: 150ms; easing: ease-out; }
            animate rise { duration: 200ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.1); }
            init => { self.opacity = 1; self.rise = 0px; }
            width: 330px; height: 46px;
            x: (parent.width - self.width) / 2;
            // Float in the lower viewer, clear of the transport controls and timeline.
            y: parent.height - self.band-h - self.height - 66px + self.rise;
            border-radius: 23px;
            background: active ? Theme.accent : #16342ef7;
            border-width: 2px;
            border-color: active ? #ffffff : Theme.accent;
            animate background, border-color { duration: 140ms; }
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000b0;
            drop-shadow-offset-y: 5px;
            Text {
                text: active ? "+  Release to create a new track" : "Drag below the last track to add one";
                color: active ? Theme.on-accent : #9ff0e4;
                animate color { duration: 140ms; }
                font-size: 12px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }


        // Delete-preset confirmation: a preset is user data, so the Delete button
        // asks first (Esc or Cancel keeps it).
        if root.confirm-delete : Modal {
            card-width: 400px; card-height: 176px; card-spacing: 12px;
            Text { text: "Delete this preset?"; color: Theme.ink; font-size: 15px; font-weight: 700; }
            Text {
                text: "\"" + root.preset-name + "\" will be removed from your presets and from the Explorer menu. This cannot be undone.";
                color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-stretch: 1;
            }
            HorizontalLayout {
                spacing: 10px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton { text: "Cancel"; clicked => { root.confirm-delete = false; } }
                DialogButton {
                    text: "Delete"; primary: true; min-width: 100px;
                    clicked => { root.confirm-delete = false; root.delete-preset(); }
                }
            }
        }

        // Import progress modal — overlays everything while files are being imported.
        if root.importing : Modal {
            card-width: 320px; card-height: 172px; card-spacing: 14px;
            Text {
                text: "Importing files…";
                color: Theme.ink; font-size: 14px; font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 8px; border-radius: 4px; background: Theme.line;
                Rectangle {
                    x: 0; height: parent.height; border-radius: 4px;
                    width: root.import-total > 0 ? parent.width * root.import-done / root.import-total : 0px;
                    // Per-file steps are chunky; glide between them.
                    animate width { duration: 250ms; easing: ease-out; }
                    background: @linear-gradient(90deg, #3f7df5 0%, Theme.accent 100%);
                }
            }
            Text {
                text: root.import-done + " / " + root.import-total;
                color: Theme.muted; font-size: 11px;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                DialogButton { text: "Cancel"; clicked => { root.import-cancel(); } }
            }
        }

        // Export settings dialog: choose codec, output resolution and bitrate, then
        // Export (which opens the save dialog and starts the render).
        if root.export-config : Modal {
            card-width: 440px; card-height: 496px;
            Text { text: "Export video"; color: Theme.ink; font-size: 15px; font-weight: 700; }

            Text { text: "FORMAT"; color: Theme.muted2; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
            ComboBox {
                model: ["H.264 · MP4  (hardware, most compatible)", "VP9 · WebM  (smaller files)", "VP8 · WebM  (older, very compatible)"];
                current-index <=> root.export-codec;
            }

            Text { text: "RESOLUTION"; color: Theme.muted2; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
            HorizontalLayout {
                spacing: 6px;
                NumberDropdown { label: "W"; value: root.export-w; minimum: 16; maximum: 7680; edited(v) => { root.export-w = v; } }
                NumberDropdown { label: "H"; value: root.export-h; minimum: 16; maximum: 4320; edited(v) => { root.export-h = v; } }
                PillButton { text: "Match canvas"; clicked => { root.export-w = root.canvas-w; root.export-h = root.canvas-h; } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 6px;
                PillButton { text: "2160p"; active: root.export-w == 3840 && root.export-h == 2160; clicked => { root.export-w = 3840; root.export-h = 2160; } }
                PillButton { text: "1080p"; active: root.export-w == 1920 && root.export-h == 1080; clicked => { root.export-w = 1920; root.export-h = 1080; } }
                PillButton { text: "720p"; active: root.export-w == 1280 && root.export-h == 720; clicked => { root.export-w = 1280; root.export-h = 720; } }
                PillButton { text: "480p"; active: root.export-w == 854 && root.export-h == 480; clicked => { root.export-w = 854; root.export-h = 480; } }
                Rectangle { horizontal-stretch: 1; }
            }

            Text { text: "FRAME RATE"; color: Theme.muted2; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
            HorizontalLayout {
                spacing: 6px;
                NumberDropdown { label: ""; value: root.export-fps; minimum: 1; maximum: 240; edited(v) => { root.export-fps = v; } }
                PillButton { text: "24"; active: root.export-fps == 24; clicked => { root.export-fps = 24; } }
                PillButton { text: "25"; active: root.export-fps == 25; clicked => { root.export-fps = 25; } }
                PillButton { text: "30"; active: root.export-fps == 30; clicked => { root.export-fps = 30; } }
                PillButton { text: "60"; active: root.export-fps == 60; clicked => { root.export-fps = 60; } }
                Rectangle { horizontal-stretch: 1; }
            }

            Text { text: "BITRATE (kbps)"; color: Theme.muted2; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
            HorizontalLayout {
                spacing: 6px;
                NumberDropdown { label: ""; value: root.export-bitrate; minimum: 100; maximum: 200000; edited(v) => { root.export-bitrate = v; } }
                PillButton { text: "Low"; active: root.export-bitrate == 2500; clicked => { root.export-bitrate = 2500; } }
                PillButton { text: "Med"; active: root.export-bitrate == 6000; clicked => { root.export-bitrate = 6000; } }
                PillButton { text: "High"; active: root.export-bitrate == 12000; clicked => { root.export-bitrate = 12000; } }
                PillButton { text: "Max"; active: root.export-bitrate == 24000; clicked => { root.export-bitrate = 24000; } }
                Rectangle { horizontal-stretch: 1; }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 10px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton { text: "Cancel"; clicked => { root.export-config = false; } }
                DialogButton {
                    text: "Export…"; primary: true; min-width: 112px;
                    enabled: root.timeline-clips.length > 0;
                    clicked => { root.export-config = false; root.video-export(); }
                }
            }
        }

        // Export/render progress modal (with Cancel).
        if root.exporting : Modal {
            card-width: 360px; card-height: 168px; card-spacing: 14px;
            Text {
                text: "Exporting video…";
                color: Theme.ink; font-size: 14px; font-weight: 700;
                horizontal-alignment: center;
            }
            Rectangle {
                height: 8px; border-radius: 4px; background: Theme.line;
                Rectangle {
                    x: 0; height: parent.height; border-radius: 4px;
                    width: parent.width * Math.clamp(root.export-progress, 0, 1);
                    animate width { duration: 180ms; easing: linear; }
                    background: @linear-gradient(90deg, #3f7df5 0%, Theme.accent 100%);
                }
            }
            Text {
                text: root.export-status;
                color: Theme.muted; font-size: 11px;
                horizontal-alignment: center; overflow: elide;
            }
            HorizontalLayout {
                alignment: center;
                DialogButton { text: "Cancel"; clicked => { root.export-cancel(); } }
            }
        }

        // Image-sequence import dialog: shows the detected frame range and lets the
        // user pick the frame rate (one file = one frame) before adding the clip.
        if root.seq-config : Modal {
            card-width: 440px; card-height: 252px;
            Text { text: "Import image sequence"; color: Theme.ink; font-size: 15px; font-weight: 700; }
            Text { text: root.seq-range; color: Theme.ink2; font-size: 12px; overflow: elide; }
            Text {
                text: root.seq-count + " frames  ·  " + Math.round(root.seq-count * 10 / Math.max(1, root.seq-fps)) / 10 + " s at " + root.seq-fps + " fps";
                color: Theme.muted; font-size: 11px;
            }

            Text { text: "FRAME RATE"; color: Theme.muted2; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
            HorizontalLayout {
                spacing: 6px;
                NumberDropdown { label: ""; value: root.seq-fps; minimum: 1; maximum: 240; edited(v) => { root.seq-fps = v; } }
                PillButton { text: "24"; active: root.seq-fps == 24; clicked => { root.seq-fps = 24; } }
                PillButton { text: "25"; active: root.seq-fps == 25; clicked => { root.seq-fps = 25; } }
                PillButton { text: "30"; active: root.seq-fps == 30; clicked => { root.seq-fps = 30; } }
                PillButton { text: "60"; active: root.seq-fps == 60; clicked => { root.seq-fps = 60; } }
                Rectangle { horizontal-stretch: 1; }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 10px;
                Rectangle { horizontal-stretch: 1; }
                DialogButton { text: "Cancel"; clicked => { root.seq-config = false; } }
                DialogButton {
                    text: "Add to timeline"; primary: true; min-width: 132px;
                    clicked => { root.seq-config = false; root.seq-confirm(); }
                }
            }
        }

        // App-wide error dialog — stays until dismissed, so failures are never
        // silent (in the release windowed build stderr does not exist). The card
        // sizes to the detail text up to most of the window, then the detail
        // scrolls — twenty file names used to render straight over the OK button.
        if root.error-visible : err-modal := Modal {
            property <length> chrome: 24px * 2 + 26px + 12px * 2 + 32px;
            card-width: 460px;
            card-padding: 24px;
            card-spacing: 12px;
            card-border: root.dialog-info ? Theme.line : #4a2a30;
            backdrop: #000000c0;
            card-height: Math.min(root.height - 80px, Math.max(200px, self.chrome + err-detail.preferred-height + 8px));
            accessible-role: text;
            accessible-label: root.error-title + ". " + root.error-detail;
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 26px; height: 26px; border-radius: 13px;
                    background: root.dialog-info ? #2dd4bf22 : #ff547022;
                    Text {
                        text: root.dialog-info ? "✓" : "!";
                        color: root.dialog-info ? Theme.accent : #ff7088;
                        font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Text { text: root.error-title; color: Theme.ink; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; }
            }
            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.visible-width;
                viewport-height: Math.max(self.visible-height, err-detail.preferred-height);
                err-detail := Text {
                    x: 0; y: 0;
                    width: err-modal.card-inner-width;
                    text: root.error-detail;
                    color: Theme.muted; font-size: 12px; wrap: word-wrap;
                }
            }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                DialogButton { text: "OK"; primary: true; min-width: 88px; clicked => { root.error-visible = false; } }
            }
        }
    }

}
