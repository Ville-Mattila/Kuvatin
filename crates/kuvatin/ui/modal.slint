import { Theme } from "theme.slint";

// A modal: dimmed, click-swallowing backdrop over the whole window and a
// centred card that fades in and rises into place. The card's contents are
// the children; `card-width` / `card-height` size it (height may be an
// expression over the contents, see the error dialog).
export component Modal inherits Rectangle {
    in property <length> card-width: 440px;
    in property <length> card-height: 200px;
    in property <color> card-border: Theme.line;
    in property <color> backdrop: #000000b0;
    in property <length> card-padding: 22px;
    in property <length> card-spacing: 11px;
    /// Exposed so a caller can size the card from its children (see the
    /// error dialog); `card` is the card itself.
    out property <length> card-inner-width: root.card-width - 2 * root.card-padding;
    /// What this dialog is, for assistive technology. Also the accessible name
    /// of the card, so a screen reader announces the dialog rather than an
    /// anonymous rectangle full of buttons.
    in property <string> title;
    /// Enter, when the focused control did not want it: the dialog's primary
    /// action. Left unconnected by dialogs whose only button is Cancel — a
    /// progress modal should not be dismissible by leaning on Return.
    callback default-action();

    background: root.backdrop;
    opacity: 0;
    animate opacity { duration: 150ms; easing: ease-out; }
    // Focus moves INTO the dialog as it opens. Without this the keyboard
    // stayed wherever it was — behind the backdrop, on controls the user can
    // no longer see, and Tab walked through them one by one.
    init => { self.opacity = 1; keys.focus(); }
    // Swallow clicks behind the modal.
    TouchArea {}
    keys := FocusScope {
        key-pressed(e) => {
            // Return here means no button had focus (a focused DialogButton
            // handles its own Return and never lets it through).
            if (e.text == Key.Return) { root.default-action(); return accept; }
            // Everything else — Esc in particular — belongs to the window's
            // handler, which knows which modal is on top.
            return reject;
        }
    }
    card := Rectangle {
        property <length> rise: 14px;
        animate rise { duration: 220ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1.12); }
        init => { self.rise = 0px; }
        width: root.card-width;
        height: root.card-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + self.rise;
        background: Theme.dialog;
        border-radius: 12px;
        border-width: 1px;
        border-color: root.card-border;
        // Slint 1.16 has no `dialog` accessible role; a labelled group is the
        // closest thing it can express, and it does at least announce the
        // dialog by name instead of as unlabelled scenery.
        accessible-role: groupbox;
        accessible-label: root.title;
        VerticalLayout {
            padding: root.card-padding;
            spacing: root.card-spacing;
            @children
        }
    }
}
