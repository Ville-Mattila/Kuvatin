<?xml version="1.0" encoding="utf-8"?>
<!--
  Kuvatin's sparse package ("package with external location"): it carries no
  files of its own, only this manifest and the logos. Registering it, with
  the install directory as the external location, gives that directory
  package identity, which is what lets kuvatin_shellext.dll appear in the
  Windows 11 top-level context menu (windows.fileExplorerContextMenus).

  It must be SIGNED: it declares a COM server ("executable activations"),
  which Windows 11 refuses in an unsigned package (0x80073D2B), so the
  unsigned-package marker is no use here. The Publisher must equal the signing
  certificate's Subject. Windows 10 has no top-level menu and keeps the
  classic registry menu only.

  @VERSION@, @PUBLISHER@ and @CLSID@ are filled in by build-msix.ps1; the
  CLSID must match kuvatin-shellext's CLSID_KUVATIN_MENU.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap uap10 rescap desktop4 desktop5 com">

  <Identity Name="VilleMattila.Kuvatin"
            Publisher="@PUBLISHER@"
            Version="@VERSION@"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Kuvatin</DisplayName>
    <PublisherDisplayName>Ville Mattila</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="Kuvatin" Executable="kuvatin.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none"
                          DisplayName="Kuvatin"
                          Description="Kuvatin's Explorer context menu"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- The handler DLL, hosted in a COM surrogate (never inside Explorer). -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Kuvatin context menu">
              <com:Class Id="@CLSID@" Path="kuvatin_shellext.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <!-- Where the "Kuvatin" entry appears: every image input type, the
             sequence-only frame type, folders, and a folder's background. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
@ITEM_TYPES@
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
